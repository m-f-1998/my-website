# Copy to server/.env for local development
DEV_MODE=true

# Optional — omit SMTP_* in dev mode to log emails to the server console instead
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=

# Required in production; optional in dev when DEV_MODE=true
# RECAPTCHA_SITE=
# RECAPTCHA_API_KEY=
# PUBLIC_DOMAIN=http://localhost:4200

# GitHub contributions graph
# Classic PAT from the account whose PRIVATE repos should be included (e.g. m-f-1998):
#   Scopes: read:user (required for private contributions)
# Also enable: GitHub → Settings → Profile → "Include private contributions on my profile"
# If private repos are in SSO orgs: Settings → Developer settings → Tokens → Configure SSO
# Other accounts in GITHUB_USERS only contribute PUBLIC activity unless you add their token too.
GITHUB_TOKEN=
GITHUB_USERS=m-f-1998,mattfrank48

# Analytics (optional — defaults exist)
# CF_BEACON_TOKEN=
# GA_TRACKING_ID=
