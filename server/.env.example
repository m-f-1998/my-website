# Copy to server/.env for local development
DEV_MODE=true

# Optional — omit SMTP_* in dev mode to log emails to the server console instead
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=

# Required in production; optional in dev when DEV_MODE=true
# RECAPTCHA_SITE=
# RECAPTCHA_API_KEY=
# PUBLIC_DOMAIN=http://localhost:4200

# GitHub contributions graph — strongly recommended for accurate heatmap + higher rate limits
# Create a fine-grained token with read:user and user:email (public read is enough for public contributions)
GITHUB_TOKEN=
GITHUB_USERS=m-f-1998,mattfrank48

# Analytics (optional — defaults exist)
# CF_BEACON_TOKEN=
# GA_TRACKING_ID=
